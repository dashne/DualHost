    <!-- Added 2026-10-31: Viber's "find contacts already on Viber" / message-from-contacts
         flow needs these on the HOST (com.ims134.dualhost) — a guest's checkSelfPermission
         always resolves against our real OS grant, so without these declared here the OS
         reports Contacts as permanently denied no matter what ClonePerms says. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Added 2026-10-31: Viber's contacts-sync path calls ContentResolver.getIsSyncable()/
         setIsSyncable(), which requires these regardless of READ_CONTACTS (confirmed from a
         device crash: SecurityException "no permission to read the sync settings"). -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Added 2026-10-31 (fatal crash, thread "TM:CONTACTS"): Viber also calls
         ContentResolver.isSyncActive() from its contacts-sync poller — a SEPARATE permission
         check from getIsSyncable()/READ_SYNC_SETTINGS above. Confirmed from device
         `adb logcat -b crash`: "SecurityException: Access denied, requires:
         android.permission.READ_SYNC_STATS" at IContentService.isSyncActive. This one was
         uncaught on a background HandlerThread (not the main thread), so it killed the whole
         process outright with no on-screen error dialog — just back to the chat list / app gone. -->
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
<!--    added by another Claude account-->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />



